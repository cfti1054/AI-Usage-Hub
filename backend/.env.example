# Railway에서는 DATABASE_URL이 자동 주입된다 (postgresql:// 형식도 자동 변환됨)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_usage_hub

# JWT 서명 키: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# API 키 암호화 키(Fernet): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=change-me

# 최초 seed 시 생성할 관리자 계정 (개인 1인 사용)
ADMIN_EMAIL=me@example.com
ADMIN_PASSWORD=change-me

SCHEDULER_ENABLED=true

# 환율 자동 조회 (선택). 한국수출입은행 Open API 인증키가 있으면 매매기준율을 우선 사용하고,
# 없거나 실패하면 Frankfurter(ECB 기준환율, 키 불필요)로 대체한다.
KOREAEXIM_API_KEY=
FX_REFRESH_HOURS=6
